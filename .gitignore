node_modules/
dist/
build/
.env
.env.*
!.env.example
.DS_Store
.vscode/
coverage/
*.log
server/.env.backup-*

# Runtime upload store — user-submitted files (product images, and KYC
# documents such as GST/PAN certificates). This is application DATA, not
# source: it must never enter version control. The directory itself is
# tracked via .gitkeep so a fresh clone still has somewhere to write.
server/uploads/*
!server/uploads/.gitkeep

# Local database dumps
*.sql
# ...but NEVER the Prisma migrations: they ARE the schema history and must ship
# with the code. Without them a deployed container logs
#   No migration found in prisma/migrations
# applies nothing, and every query fails with P2021 ("table does not exist")
# against a database that is reachable and empty.
!server/prisma/migrations/**/*.sql
server/uploads-test/

# Personal productivity workspace (/productivity:start). Local notes and a
# local dashboard — not part of the application, and TASKS.md/memory may hold
# private names and context that should not reach a shared repo.
/TASKS.md
/dashboard.html
/memory/

# pnpm artefacts. This project deploys with `npm ci` from package-lock.json;
# a committed pnpm lockfile can make a build pick the wrong package manager.
pnpm-lock.yaml
pnpm-workspace.yaml

# Historical business data imported from the operations spreadsheet. Contains
# REAL customer names, company names and mobile numbers. This repository is
# PUBLIC, and git history is permanent — committing this would publish personal
# contact details irreversibly. The importer (server/scripts/import-legacy-
# orders.mjs) IS tracked; the data it reads is not. Keep the file locally and
# run the import against the database directly.
server/data/*.json
# ...but the fictional shape reference IS tracked, so the importer is usable
# and self-documenting without exposing anyone's details.
!server/data/*.example.json
