// Zolo Packaging — canonical persistence layer (PostgreSQL 16 via Prisma).
// THE single source of truth for the database. The legacy MongoDB backend was
// decommissioned; this schema now owns the full commerce domain.
//
// Conventions (see docs/DATABASE_DOMAIN_REFERENCE.md):
//  - Money is ALWAYS an integer in minor units (paise). No floats. A
//    basePriceMinor of 0 means "quotation-based" (never rendered as ₹0).
//  - Order/quotation line items carry a frozen SNAPSHOT of product data so
//    historical records are immune to later catalog edits.
//  - History/ledger/audit tables are append-only and never cascade-deleted.
//  - Soft-delete (deletedAt) only where a real archive is needed
//    (products, categories, customers, coupons).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY & ORGANIZATION (auth foundation)
// ============================================================

enum UserRole {
  buyer
  seller_owner
  seller_admin
  seller_staff
  admin
  verification_admin
  finance_admin
  operations_admin
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  // Stored normalized (digits only, last 10). Unique+sparse so it can be used
  // as a login identifier; null phones don't collide.
  phone          String?   @unique
  passwordHash   String
  firstName      String
  lastName       String?
  role           UserRole  @default(buyer)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  // ---- Customer profile (User is the single source of truth; the legacy
  // `Customer` table is unused). All optional so existing rows are untouched.
  avatarUrl      String? // public upload URL of the profile photo (null = default avatar)
  alternatePhone String?
  company        String? // business / company name
  businessType   String?
  gstin          String?
  pan            String?
  website        String?
  industry       String?
  dateOfBirth    DateTime? @db.Date
  gender         String? // male | female | other | prefer_not_to_say (validated in the API)
  // Notification / communication opt-ins, e.g. { orderUpdates, rfqUpdates,
  // marketingEmail, whatsapp, sms }. Absent keys mean "default (on)".
  preferences    Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships            OrganizationMember[]
  sessions               Session[]
  // audit/notification back-references
  auditLogs              AuditLog[]             @relation("AuditActor")
  notifications          Notification[]
  // commerce back-references
  customer               Customer?
  addresses              Address[]
  orders                 Order[]
  reviews                Review[]
  wishlist               Wishlist?
  cart                   Cart?
  sellerProducts         Product[]              @relation("ProductSeller")
  stockMovements         StockMovement[]        @relation("StockMovementActor")
  rfqs                   Rfq[]
  quotations             Quotation[]
  authoredQuotations     Quotation[]            @relation("QuotationAuthor")
  // payment requests (custom payment links)
  paymentRequests        PaymentRequest[]       @relation("PaymentRequestCustomer")
  createdPaymentRequests PaymentRequest[]       @relation("PaymentRequestCreator")
  notificationDeliveries NotificationDelivery[]
  sentMessages           Message[]              @relation("MessageSender")
  savedRequirements      SavedRequirement[]
  rfqFiles               RfqFile[]              @relation("RfqFileUploader")
  returnRequests         ReturnRequest[]
  ecoCreditTransactions  EcoCreditTransaction[]
  recyclingRequests      RecyclingRequest[]
  assignedCoupons        Coupon[]               @relation("AssignedCoupons")
  catalogImports         CatalogImport[]        @relation("CatalogImporter")

  @@index([role])
}

// A persisted session/refresh record. The access token is a short-lived JWT;
// this row lets us revoke sessions (logout, suspension) server-side.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the refresh token — never the raw token
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum OrgKind {
  buyer
  supplier
}

model Organization {
  id        String   @id @default(cuid())
  kind      OrgKind  @default(supplier)
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         OrganizationMember[]
  supplierProfile SupplierProfile?

  @@index([kind])
}

enum OrgMemberRole {
  owner
  admin
  staff
}

model OrganizationMember {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRole     OrgMemberRole @default(owner)
  createdAt      DateTime      @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ============================================================
// SUPPLIER / SELLER ONBOARDING
// ============================================================

enum SupplierStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessType {
  MANUFACTURER
  CONVERTER
  TRADER
  DISTRIBUTOR
  PRINTING
  PACKAGING_SPECIALIST
  OTHER
}

// The onboarding wizard step the seller has reached (0-based index into the
// canonical step list defined in the application; persisted so drafts resume).
model SupplierProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Business details
  legalName           String?
  displayName         String?
  businessType        BusinessType?
  registrationNumber  String?
  website             String?
  yearEstablished     Int?
  employeeCount       Int?
  annualTurnoverMinor BigInt? // minor units; optional
  description         String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?

  // Legal & tax (normalized/uppercased on write; never government-verified here)
  gstNumber String? @unique
  panNumber String? @unique
  cinNumber String?

  // Workflow state
  status             SupplierStatus     @default(DRAFT)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  onboardingStep     Int                @default(0)
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations      SupplierLocation[]
  capabilities   SupplierCapability[]
  certifications SupplierCertification[]
  documents      SupplierDocument[]
  machinery      SupplierMachine[]
  materials      SupplierMaterial[]
  bankAccounts   SupplierBankAccount[]
  capacity       SupplierCapacity?
  quality        SupplierQuality?
  logistics      SupplierLogistics?
  statusHistory  SupplierStatusHistory[]
  changeRequests SupplierChangeRequest[]
  rfqMatches     RfqMatch[]
  quotations     Quotation[]             @relation("QuotationSupplier")
  payouts        Payout[]

  @@index([status])
  @@index([verificationStatus])
}

enum LocationType {
  HEAD_OFFICE
  FACTORY
  WAREHOUSE
  DISPATCH
  BILLING
}

model SupplierLocation {
  id           String          @id @default(cuid())
  supplierId   String
  supplier     SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  locationType LocationType
  isPrimary    Boolean         @default(false)
  isActive     Boolean         @default(true)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String          @default("India")
  contactName  String?
  contactPhone String?
  createdAt    DateTime        @default(now())

  @@index([supplierId])
  @@index([locationType])
}

// Capabilities link to the existing product taxonomy by category name (Product.category)
// so RFQ matching can query against real catalog categories.
model SupplierCapability {
  id                   String          @id @default(cuid())
  supplierId           String
  supplier             SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category             String // aligns with Product.category taxonomy
  subCategory          String?
  materials            String[]        @default([])
  finishes             String[]        @default([])
  printingMethods      String[]        @default([])
  minimumOrderQuantity Int?
  maximumOrderQuantity Int?
  leadTimeDays         Int?
  customization        Boolean         @default(false)
  sampleAvailable      Boolean         @default(false)
  createdAt            DateTime        @default(now())

  @@index([supplierId])
  @@index([category])
}

model SupplierCapacity {
  id                   String          @id @default(cuid())
  supplierId           String          @unique
  supplier             SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  monthlyCapacity      Int?
  dailyCapacity        Int?
  minimumOrderQuantity Int?
  maximumOrderQuantity Int?
  standardLeadTimeDays Int?
  rushCapacity         Boolean         @default(false)
  productionShifts     Int?
  workingDays          Int? // days/week
  seasonalNotes        String?
  updatedAt            DateTime        @updatedAt
}

model SupplierMachine {
  id           String          @id @default(cuid())
  supplierId   String
  supplier     SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  machineName  String
  machineType  String?
  manufacturer String?
  model        String?
  quantity     Int             @default(1)
  capacity     String?
  year         Int?
  status       String?
  createdAt    DateTime        @default(now())

  @@index([supplierId])
}

model SupplierMaterial {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  material   String
  grade      String?
  thickness  String?
  gsm        Int?
  bf         Int? // bursting factor
  flute      String?
  paperType  String?
  boardType  String?
  coating    String?
  lamination String?
  createdAt  DateTime        @default(now())

  @@index([supplierId])
}

model SupplierCertification {
  id                 String             @id @default(cuid())
  supplierId         String
  supplier           SupplierProfile    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name               String
  certificateNumber  String?
  issuer             String?
  issueDate          DateTime?
  expiryDate         DateTime?
  documentId         String?            @unique
  document           SupplierDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())

  @@index([supplierId])
  @@index([expiryDate])
}

enum DocumentType {
  GST_CERTIFICATE
  PAN
  COMPANY_REGISTRATION
  FACTORY_LICENSE
  ADDRESS_PROOF
  BANK_PROOF
  CANCELLED_CHEQUE
  CERTIFICATION
  QUALITY_CERTIFICATE
  FACTORY_PHOTO
  MACHINERY_DOCUMENT
  OTHER
}

model SupplierDocument {
  id                 String             @id @default(cuid())
  supplierId         String
  supplier           SupplierProfile    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type               DocumentType
  fileName           String
  storageKey         String // opaque key into the storage abstraction — never a public path
  mimeType           String
  size               Int
  uploadedById       String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?
  expiresAt          DateTime?
  createdAt          DateTime           @default(now())

  certification SupplierCertification?

  @@index([supplierId])
  @@index([type])
}

// Bank details: sensitive. Full account number is never returned by the API —
// only accountLast4 is exposed. accountNumberEnc holds an encrypted/opaque value.
model SupplierBankAccount {
  id                String          @id @default(cuid())
  supplierId        String
  supplier          SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  accountHolderName String
  bankName          String
  accountNumberEnc  String // encrypted at the service layer; never plaintext in responses
  accountLast4      String
  ifsc              String
  branch            String?
  paymentTerms      String?
  currency          String          @default("INR")
  isPrimary         Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@index([supplierId])
}

model SupplierQuality {
  id                  String          @id @default(cuid())
  supplierId          String          @unique
  supplier            SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  qualityProcess      String?
  inspectionProcess   String?
  testingCapability   String?
  qcCertifications    String[]        @default([])
  samplingProcess     String?
  defectHandling      String?
  returnReworkProcess String?
  updatedAt           DateTime        @updatedAt
}

model SupplierLogistics {
  id                 String          @id @default(cuid())
  supplierId         String          @unique
  supplier           SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  serviceableRegions String[]        @default([])
  deliveryLocations  String[]        @default([])
  dispatchCapability String?
  shippingMethods    String[]        @default([])
  avgDispatchDays    Int?
  preferredPartners  String[]        @default([])
  pickupAvailable    Boolean         @default(false)
  updatedAt          DateTime        @updatedAt
}

// Immutable status-transition history (append-only).
model SupplierStatusHistory {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fromStatus SupplierStatus?
  toStatus   SupplierStatus
  actorId    String?
  reason     String?
  createdAt  DateTime        @default(now())

  @@index([supplierId])
}

// A change-request raised by an admin; carries section-specific issues.
model SupplierChangeRequest {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  raisedById String
  resolved   Boolean         @default(false)
  resolvedAt DateTime?
  issues     Json            @default("[]") // [{ section, message }]
  createdAt  DateTime        @default(now())

  @@index([supplierId])
  @@index([resolved])
}

// ============================================================
// CROSS-CUTTING: AUDIT + NOTIFICATIONS + DOMAIN EVENTS
// ============================================================

model AuditLog {
  id             String   @id @default(cuid())
  eventType      String
  actorId        String?
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?
  entityType     String?
  entityId       String?
  metadata       Json     @default("{}") // never contains secrets/PII like bank numbers
  createdAt      DateTime @default(now())

  @@index([eventType])
  @@index([entityType, entityId])
  @@index([organizationId])
}

enum NotificationStatus {
  UNREAD
  READ
}

// Outbound (out-of-app) delivery attempts — WhatsApp/SMS/email to the owner or
// a customer. Separate from Notification (the in-app bell): a delivery has a
// provider, can fail, and must record WHAT happened truthfully. SKIPPED means
// no provider was configured — never faked as SENT.
enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
  READ
}

model NotificationDelivery {
  id                String         @id @default(cuid())
  channel           String // "email" | "whatsapp" | "sms" | "in_app"
  provider          String // "smtp" | "meta" | "none"
  recipient         String // email / E.164-ish phone; "unconfigured" when none
  messageType       String // e.g. "ORDER_CREATED" / "rfq.created"
  entityType        String?
  entityId          String?
  // The customer this delivery was for (null for owner/admin alerts).
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subject           String?
  body              String?
  status            DeliveryStatus @default(PENDING)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  failedAt          DateTime?
  readAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([entityType, entityId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([channel, createdAt])
}

model Notification {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  status     NotificationStatus @default(UNREAD)
  createdAt  DateTime           @default(now())

  @@index([userId, status])
}

enum ProductStatus {
  draft
  active
  archived
}

model Product {
  id              String        @id // PRD-xxxx (app-generated, stable across UI)
  sku             String        @unique
  slug            String        @unique
  name            String
  // `category`/`subcategory` remain as denormalized taxonomy strings (used by
  // SupplierCapability matching and legacy queries); categoryId is the
  // normalized relation to the Category table.
  category        String
  subcategory     String        @default("General")
  categoryId      String?
  categoryRef     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Normalized subcategory relation. The denormalized `subcategory` string
  // above is kept in sync (legacy queries + SupplierCapability matching read
  // it); this is the FK used for real taxonomy navigation.
  subcategoryId   String?
  subcategoryRef  Category?     @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  sellerId        String? // owning supplier user (null = house catalog)
  seller          User?         @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  status          ProductStatus @default(draft)
  description     String?
  // dimensions
  length          Float?
  width           Float?
  height          Float?
  dimUnit         String? // in | cm | mm
  weightGrams     Int?
  gsm             Int?
  color           String?
  material        String?
  // Catalog "Type" column (e.g. "Packaging Box", "Cup") — a descriptor, not a
  // taxonomy node.
  productType     String?
  // Catalog "Thickness" column; free text because sources mix units.
  thickness       String?
  // The Size cell VERBATIM ("12 oz", "500 ml", "A4", "12 x 4 x 4 inch").
  // Only true 3D sizes populate length/width/height; capacities and sheet
  // sizes would be meaningless as dimensions, so they are preserved here
  // instead of being discarded.
  sizeLabel       String?
  printing        String? // printing method (offset, flexo, digital…)
  finishing       String? // lamination / foil / spot-UV / emboss…
  customizable    Boolean       @default(false)
  // money — integer minor units (paise); base 0 = quotation-based
  basePriceMinor  Int           @default(0)
  salePriceMinor  Int? // optional promotional price
  costMinor       Int? // internal unit cost (never exposed to buyers)
  moq             Int           @default(500)
  stock           Int           @default(0) // on-hand quantity
  reservedStock   Int           @default(0) // held for in-flight orders (available = stock - reserved)
  lowStockLevel   Int?
  imageEmoji      String        @default("📦") // primary image (emoji or URL)
  images          String[]      @default([]) // ordered; [0] = primary
  variants        Json          @default("[]")
  // Homepage merchandising — set ONLY by an admin in the Add/Edit product form
  // (or the catalog row actions). The storefront rails read these flags; they
  // are never inferred from createdAt, API order or position. The two rails
  // are independent: a product may be in both, each with its own order
  // (null order = after every explicitly ordered product).
  isFeatured      Boolean       @default(false)
  featuredOrder   Int?
  isNewArrival    Boolean       @default(false)
  newArrivalOrder Int?
  deletedAt       DateTime? // soft-delete; archived products keep order snapshots intact
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reviews        Review[]
  wishlistItems  WishlistItem[]
  aiAnalysis     ProductAiAnalysis?
  stockMovements StockMovement[]
  rfqItems       RfqItem[]
  quotationItems QuotationItem[]
  // Commission the platform takes on this product, in BASIS POINTS
  // (800 = 8.00%). Integer, like money, so a rate never suffers float
  // drift. Admin-set per product; null falls back to the platform default.
  commissionBps  Int?
  priceTiers     PriceTier[]
  coupons        CouponProduct[]
  campaigns      Campaign[]

  @@index([status])
  @@index([isFeatured, featuredOrder])
  @@index([isNewArrival, newArrivalOrder])
  @@index([category])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([sellerId])
}

// ============================================================
// COMMERCE DOMAIN
// (customers, catalog taxonomy, cart, orders, payments,
//  shipping, coupons, reviews, wishlist)
// ============================================================

// A buyer's commercial profile, 1:1 with a User whose role is `buyer`.
// Financial/order history is never hard-deleted — customers soft-archive.
model Customer {
  id                 String          @id @default(cuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerCode       String          @unique // CUST-xxxx, app-generated
  company            String?
  gstin              String?
  segment            CustomerSegment @default(small_seller)
  status             CustomerStatus  @default(active)
  lifetimeValueMinor Int             @default(0)
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  orders             Order[]
  rfqs               Rfq[]

  @@index([status])
}

enum CustomerSegment {
  small_seller
  d2c_brand
  enterprise
}

enum CustomerStatus {
  active
  archived
}

// One canonical address table (billing/shipping) owned by a user. Order
// addresses are snapshotted onto the order, so editing this never rewrites
// historical shipments.
model Address {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       AddressKind @default(shipping)
  label      String? // nickname shown in the address book, e.g. "Home", "Office", "Warehouse"
  name       String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String      @default("India")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId, kind])
}

enum AddressKind {
  billing
  shipping
}

// Hierarchical product taxonomy (self-referential parent): a top-level
// category has parentId = null, a subcategory points at its parent. Managed
// by the admin (Product Catalog → Categories); the storefront only ever sees
// active, non-archived rows, in sortOrder.
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String? // legacy, unused
  image       String? // uploaded through the uploads pipeline (URL only)
  sortOrder   Int        @default(0) // display order among siblings (lower first)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  isActive    Boolean    @default(true)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]
  subProducts Product[]        @relation("ProductSubcategory")
  coupons     CouponCategory[]
  campaigns   Campaign[]

  @@index([parentId, sortOrder])
  @@index([isActive])
}

// One active cart per customer (unique userId).
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  variant        String? // selected variant descriptor (size/material/etc.)
  quantity       Int      @default(1)
  unitPriceMinor Int // price snapshot at add-to-cart time
  createdAt      DateTime @default(now())

  @@unique([cartId, productId, variant])
  @@index([cartId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // ORD-xxxx, app-generated
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  // money — integer minor units (paise)
  subtotalMinor   Int           @default(0)
  discountMinor   Int           @default(0)
  taxMinor        Int           @default(0)
  shippingMinor   Int           @default(0)
  grandTotalMinor Int           @default(0)
  paidMinor       Int           @default(0)
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode      String? // snapshot of the code applied (coupon may later change)
  paymentMethod   String        @default("cod") // cod | upi | card | netbanking …
  currency        String        @default("INR")
  notes           String?
  cancelReason    String?
  // frozen shipping-address snapshot (never a live FK — addresses must freeze)
  shipName        String?
  shipPhone       String?
  shipLine1       String?
  shipLine2       String?
  shipCity        String?
  shipState       String?
  shipPostalCode  String?
  shipCountry     String?       @default("India")
  // frozen billing-address snapshot (falls back to shipping when omitted)
  billName        String?
  billPhone       String?
  billLine1       String?
  billLine2       String?
  billCity        String?
  billState       String?
  billPostalCode  String?
  billCountry     String?       @default("India")
  // frozen contact email at placement (the User's email may change later)
  customerEmail   String?
  placedAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payments         Payment[]
  shipments        Shipment[]
  invoice          Invoice?
  couponRedemption CouponRedemption?
  returnRequests   ReturnRequest[]
  paymentRequests  PaymentRequest[]
  // Cash-on-delivery surcharge applied at placement (from Payment Settings);
  // already included in grandTotalMinor.
  codChargeMinor   Int                  @default(0)
  // Provenance when this order came from an accepted quotation.
  rfqId            String?
  rfq              Rfq?                 @relation(fields: [rfqId], references: [id])
  quotationId      String?
  quotation        Quotation?           @relation(fields: [quotationId], references: [id])
  // Sum of the line-level commission snapshots.
  commissionMinor  Int                  @default(0)

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

// Frozen snapshot — immune to later product/price edits.
model OrderItem {
  id              String          @id @default(cuid())
  returnRequests  ReturnRequest[]
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String? // reference only; snapshot below is the source of truth
  productName     String
  sku             String?
  variant         String?
  specs           Json            @default("{}") // dimensions/gsm/material/printing/finishes
  quantity        Int
  unitPriceMinor  Int
  discountMinor   Int             @default(0)
  taxMinor        Int             @default(0)
  lineTotalMinor  Int
  // Commission SNAPSHOT. Both the rate and the resolved amount are frozen
  // here at order creation, so changing a product's rate later never
  // restates historical payouts.
  commissionBps   Int             @default(0)
  commissionMinor Int             @default(0)

  @@index([orderId])
}

// Append-only order status transitions.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique // PAY-xxxx
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  method        String // upi | card | neft | cheque | cash
  amountMinor   Int
  status        PaymentStatus @default(PENDING)
  reference     String? // gateway/transaction reference
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  refunds        Refund[]
  paymentRequest PaymentRequest?

  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Admin-managed payment methods (Settings → Payments). One row per method key;
// customer-facing checkout only offers rows with enabled = true. `config` holds
// method-specific fields (COD limits/charge, UPI id + QR image URL, bank
// details). Nothing secret lives here — a QR image is a public asset.
// ---------------------------------------------------------------------------
model PaymentMethodSetting {
  id          String   @id @default(cuid())
  key         String   @unique // cod | upi | bank_transfer | neft | cheque
  enabled     Boolean  @default(true)
  displayName String
  description String?
  sortOrder   Int      @default(0)
  config      Json     @default("{}")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// ---------------------------------------------------------------------------
// Admin-managed notification configuration (Settings → Notifications). A
// singleton row (id = "default"). Secrets (SMTP password, WhatsApp token) are
// stored AES-256-GCM encrypted (lib/crypto encryptField) and never returned to
// the browser — the API only reports whether one is set.
// ---------------------------------------------------------------------------
model NotificationSetting {
  id                     String   @id @default("default")
  emailEnabled           Boolean  @default(false)
  whatsappEnabled        Boolean  @default(false)
  smsEnabled             Boolean  @default(false)
  inAppEnabled           Boolean  @default(true)
  // { EVENT_KEY: { email, whatsapp, sms, inApp } } — missing keys use defaults.
  eventMatrix            Json     @default("{}")
  // Email / SMTP
  smtpHost               String?
  smtpPort               Int?
  smtpSecure             Boolean  @default(false)
  smtpUser               String?
  smtpPassEnc            String?
  fromEmail              String?
  fromName               String?
  replyTo                String?
  // WhatsApp
  whatsappProvider       String? // "meta"
  whatsappPhoneNumberId  String?
  whatsappAccessTokenEnc String?
  whatsappBusinessNumber String? // display / owner number, digits only
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Custom payment requests ("send a payment link"). Created by an admin for a
// customer, optionally tied to an order/quotation. The customer opens a
// secure link (random 256-bit token; only its hash is indexed, the plaintext is
// stored encrypted so the admin can re-share it), pays via an enabled offline
// method (UPI/QR, bank transfer…), submits the reference/proof, and an admin
// verifies before it is marked PAID — never auto-paid from a client claim.
// ---------------------------------------------------------------------------
enum PaymentRequestStatus {
  PENDING // created, link not yet sent
  SENT // link sent to the customer
  SUBMITTED // customer submitted payment reference/proof — awaiting review
  PAID // admin verified and recorded the payment
  REJECTED // admin rejected the submitted proof
  EXPIRED
  CANCELLED
}

model PaymentRequest {
  id             String               @id @default(cuid())
  requestNumber  String               @unique // PR-xxxx
  userId         String
  user           User                 @relation("PaymentRequestCustomer", fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quotationId    String?
  quotation      Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  amountMinor    Int
  currency       String               @default("INR")
  status         PaymentRequestStatus @default(PENDING)
  allowedMethods String[]             @default([])
  tokenHash      String               @unique
  tokenEnc       String
  expiresAt      DateTime?
  createdById    String
  createdBy      User                 @relation("PaymentRequestCreator", fields: [createdById], references: [id])
  sentAt         DateTime?
  // customer submission
  submittedAt    DateTime?
  proofMethod    String?
  proofReference String?
  proofNote      String?
  proofFileKey   String? // private storage key — streamed only via admin route
  proofFileName  String?
  proofMime      String?
  // admin review
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  paidAt         DateTime?
  paymentId      String?              @unique
  payment        Payment?             @relation(fields: [paymentId], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId, status])
  @@index([status])
  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Refund {
  id              String         @id @default(cuid())
  refundNumber    String         @unique
  paymentId       String
  payment         Payment        @relation(fields: [paymentId], references: [id])
  amountMinor     Int
  reason          String?
  status          RefundStatus   @default(requested)
  // Manual-settlement proof (UTR / transaction id) — a refund is only marked
  // processed against a real reference, never on a button click alone.
  reference       String?
  processedById   String?
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  // Set when the refund resolves a customer return request.
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([paymentId])
}

enum RefundStatus {
  requested
  approved
  processed
  rejected
}

model Shipment {
  id             String         @id @default(cuid())
  shipmentNumber String         @unique // SHP-xxxx
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  courier        String? // FedEx | BlueDart | DHL | Delhivery…
  trackingNumber String?
  status         ShipmentStatus @default(PACKING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  expectedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  events ShipmentEvent[]

  @@index([orderId])
  @@index([status])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  location   String?
  note       String?
  createdAt  DateTime       @default(now())

  @@index([shipmentId, createdAt])
}

enum ShipmentStatus {
  PACKING
  AWB_BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Coupon {
  id                    String       @id @default(cuid())
  code                  String       @unique // normalized: trimmed + uppercased (WELCOME10 == welcome10)
  name                  String?
  description           String?
  discountType          DiscountType
  discountValue         Int // percent (basis) OR flat minor units, per type
  minOrderMinor         Int?
  maxDiscountMinor      Int?
  usageLimit            Int?
  usedCount             Int          @default(0)
  // Redemptions allowed per customer. NULL = unlimited. Defaults to 1, which
  // is the single-use-per-customer rule every coupon had before this field.
  usageLimitPerCustomer Int?         @default(1)
  validFrom             DateTime?
  validUntil            DateTime? // NEVER auto-deleted (no TTL) — history is preserved
  isActive              Boolean      @default(true)
  // Draft = saved but never published. The effective status (draft / scheduled
  // / active / paused / expired / usage_limit_reached) is always DERIVED on the
  // server from isDraft + isActive + the dates + the usage counter.
  isDraft               Boolean      @default(false)
  appliesTo             CouponScope  @default(all)
  allowSaleItems        Boolean      @default(true)
  allowOtherDiscounts   Boolean      @default(true)
  // Eco Reward coupons are generated by a redemption and belong to ONE
  // customer: checkout refuses them for anybody else.
  source                CouponSource @default(admin)
  assignedUserId        String?
  assignedUser          User?        @relation("AssignedCoupons", fields: [assignedUserId], references: [id], onDelete: SetNull)
  deletedAt             DateTime? // archived
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]
  products    CouponProduct[]
  categories  CouponCategory[]

  @@index([isActive])
  @@index([validFrom, validUntil])
  @@index([assignedUserId])
  @@index([source])
}

enum CouponSource {
  admin
  eco_reward
}

// What a coupon discounts: the whole cart, or only lines for chosen products /
// categories (a category also covers its subcategories).
enum CouponScope {
  all
  products
  categories
}

model CouponProduct {
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Campaigns — admin-authored promotional content rendered by the storefront.
// Content is STRUCTURED fields only (never HTML/JS). Whether a campaign is live
// is derived on the server from isDraft + isActive + startAt/endAt.
// ---------------------------------------------------------------------------
enum CampaignContentType {
  text
  image
  quote
  text_image
  promo_card
}

enum CampaignPlacementKey {
  announcement_bar
  homepage_hero
  homepage_promo_card
  homepage_popup
  product_listing
  product_detail
  cart
  checkout
}

enum CampaignCtaType {
  none
  product
  category
  shop
  cart
  external
}

enum CampaignPopupPosition {
  center
  bottom_right
  bottom_left
}

enum CampaignPopupFrequency {
  every_visit
  once_per_session
  once_per_day
  once_per_campaign
  always
}

model Campaign {
  id             String              @id @default(cuid())
  name           String // internal name, never shown to customers
  contentType    CampaignContentType
  title          String?
  subtitle       String?
  description    String?
  quote          String?
  quoteAuthor    String?
  imageUrl       String? // storage URL (uploads pipeline) — never binary data
  mobileImageUrl String? // optional; storefront falls back to imageUrl
  imageAlt       String?
  badgeText      String?
  buttonText     String?
  // Structured CTA: the link is resolved on the server from these, so admins
  // pick a product/category instead of typing internal URLs.
  ctaType        CampaignCtaType     @default(none)
  ctaProductId   String?
  ctaProduct     Product?            @relation(fields: [ctaProductId], references: [id], onDelete: SetNull)
  ctaCategoryId  String?
  ctaCategory    Category?           @relation(fields: [ctaCategoryId], references: [id], onDelete: SetNull)
  ctaUrl         String? // external only; http(s) validated on write

  isActive Boolean  @default(true)
  isDraft  Boolean  @default(false)
  startAt  DateTime
  endAt    DateTime
  priority Int      @default(1) // lower = shown first

  // Homepage popup behaviour (ignored by other placements).
  popupPosition     CampaignPopupPosition  @default(center)
  popupFrequency    CampaignPopupFrequency @default(once_per_session)
  popupDelaySeconds Int                    @default(3)
  popupAllowClose   Boolean                @default(true)
  popupOverlay      Boolean                @default(true)

  createdById String?
  deletedAt   DateTime? // archived
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  placements CampaignPlacement[]

  @@index([isActive, startAt, endAt])
  @@index([priority])
}

model CampaignPlacement {
  id         String               @id @default(cuid())
  campaignId String
  campaign   Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement  CampaignPlacementKey

  @@unique([campaignId, placement])
  @@index([placement])
}

// Per-user coupon usage ledger — enforces per-customer usage limits and gives
// an auditable redemption history (the global Coupon.usedCount is a fast counter).
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId        String
  orderId       String   @unique // one redemption per order
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountMinor Int
  createdAt     DateTime @default(now())

  @@index([couponId, userId])
}

// A tax invoice for a paid/confirmed order. Invoice numbers are a safe,
// server-generated monotonic series (see InvoiceCounter). One invoice per order.
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // ZOLO/2026/000001 — generated server-side
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          InvoiceStatus @default(issued)
  // money snapshot at issue time (paise)
  subtotalMinor   Int
  discountMinor   Int           @default(0)
  taxMinor        Int           @default(0)
  shippingMinor   Int           @default(0)
  grandTotalMinor Int
  gstin           String? // seller/company GSTIN if configured
  issuedAt        DateTime      @default(now())

  @@index([status])
}

enum InvoiceStatus {
  issued
  paid
  cancelled
}

// Single-row counter table for gapless, race-safe invoice sequence numbers.
// Incremented inside the order transaction with a row lock.
model InvoiceCounter {
  id   Int @id @default(1)
  year Int
  seq  Int @default(0)
}

enum DiscountType {
  percent
  flat
}

// One review per user per product (unique constraint).
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
}

// One wishlist per user; items reference products.
model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

// ============================================================
// AI PRODUCT GENERATION (from existing catalog images)
// ============================================================

// One analysis per source image. Caches the derived product data keyed by an
// image content hash so the same image is never re-analyzed (cost control).
// The analysis is the source for a DRAFT Product the admin reviews & approves.
// Tags + SEO live here (not on Product) so the Product schema stays lean.
model ProductAiAnalysis {
  id               String           @id @default(cuid())
  imageHash        String           @unique // sha256 of the source image bytes (cache key)
  sourceName       String // original filename (never modified/renamed on disk)
  status           AiAnalysisStatus @default(ANALYZED)
  // derived product fields (all nullable — REVIEW_REQUIRED rows carry little)
  name             String?
  suggestedSku     String?
  category         String?
  isNewCategory    Boolean          @default(false) // category not in existing taxonomy
  productType      String?
  material         String?
  color            String?
  shape            String?
  usage            String[]         @default([])
  description      String?
  shortDescription String?
  tags             String[]         @default([])
  seoTitle         String?
  seoDescription   String?
  imageUrl         String? // uploaded copy's permanent URL (original file untouched)
  // per-field confidence (0..100) + overall
  confidence       Json             @default("{}") // { overall, name, category, material }
  reviewReason     String? // why REVIEW_REQUIRED, when applicable
  // link to the created draft product (set once a draft exists)
  productId        String?          @unique
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
}

enum AiAnalysisStatus {
  NOT_ANALYZED
  ANALYZING
  ANALYZED
  REVIEW_REQUIRED
  FAILED
  APPROVED
  REJECTED
}

// ============================================================
// INVENTORY LEDGER
// ============================================================

// Append-only record of every stock change.
//
// `Product.stock` remains the fast read path, but it must only ever move
// through recordMovement(), which writes the matching ledger row in the SAME
// transaction. `quantity` is signed: positive adds to stock, negative removes,
// so the sum of a product's movements reconciles against Product.stock.
//
// Rows are never updated or deleted — a mistake is corrected by posting a
// compensating ADJUSTMENT, which keeps the audit trail intact.
model StockMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MovementType
  // Signed delta applied to Product.stock (+receipt / -consumption).
  quantity  Int
  // Running on-hand quantity immediately AFTER this movement, so history can
  // be read back without replaying the whole ledger.
  balance   Int
  reason    String?
  // Free-form provenance: the order, purchase order or job card that caused
  // this movement. Kept as a loose reference so the ledger does not need a
  // foreign key to models that may not exist yet.
  refType   String?
  refId     String?
  actorId   String?
  actor     User?        @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([type])
  @@index([refType, refId])
}

enum MovementType {
  RECEIPT // goods received (purchase, opening stock)
  CONSUMPTION // materials consumed by production
  PRODUCTION_OUTPUT // finished goods produced
  DISPATCH // shipped against an order
  RETURN // customer/production return back into stock
  ADJUSTMENT // manual correction (stock take)
  DAMAGE // written off
}

// ============================================================
// RFQ (Request for Quotation) -> Quotation -> Order
//
// A buyer collects MULTIPLE products into ONE RFQ (RFQ-1001 may hold
// Product A x5000, B x10000, C x2000) — never one RFQ per product.
// Admin answers an RFQ with a Quotation; the buyer accepts it and the
// quotation converts to an Order that references both.
// ============================================================

enum RfqStatus {
  DRAFT // buyer is still building it (RFQ cart)
  SUBMITTED // waiting for admin
  UNDER_REVIEW // admin has opened it
  QUOTED // at least one quotation sent
  ACCEPTED // buyer accepted a quotation
  REJECTED // buyer rejected, or admin declined to quote
  CANCELLED // buyer withdrew
  EXPIRED
}

enum QuotationStatus {
  DRAFT // admin is composing
  SENT // visible to the buyer
  ACCEPTED
  REJECTED
  CHANGES_REQUESTED // buyer asked for a revision -> admin sends a new version
  EXPIRED
  WITHDRAWN
}

model Rfq {
  id             String    @id @default(cuid())
  rfqNumber      String    @unique // RFQ-1001, app-generated
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  status         RfqStatus @default(DRAFT)
  // Buyer-supplied context for the whole request.
  title          String?
  notes          String?
  currency       String    @default("INR")
  requiredBy     DateTime? // buyer's needed-by date
  // Delivery target — snapshot, never a live FK (addresses must freeze).
  shipCity       String?
  shipState      String?
  shipPostalCode String?
  shipCountry    String?   @default("India")
  submittedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items      RfqItem[]
  quotations Quotation[]
  orders     Order[]
  matches    RfqMatch[]
  messages   Message[]
  files      RfqFile[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// A requirement sheet / reference document attached to an RFQ (spec sheet,
// artwork, dimension drawing). Stored in the PRIVATE uploads tree and streamed
// only through authorized routes — never via the static /uploads mount, since a
// requirement sheet can carry customer contact data and target prices.
model RfqFile {
  id           String   @id @default(cuid())
  rfqId        String
  rfq          Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  fileName     String // original name, for display/download only
  storageKey   String // private-tree key; never exposed to the client
  mimeType     String
  size         Int
  uploadedById String
  uploadedBy   User     @relation("RfqFileUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([rfqId])
}

// One line per requested product. quantity is what the buyer asked for.
model RfqItem {
  id               String   @id @default(cuid())
  rfqId            String
  rfq              Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId        String? // reference only; snapshot below is the source of truth
  product          Product? @relation(fields: [productId], references: [id])
  productName      String
  sku              String?
  variant          String?
  specs            Json     @default("{}") // dimensions/gsm/material/printing/finishes
  quantity         Int
  unit             String   @default("pcs")
  targetPriceMinor Int? // optional buyer expectation
  notes            String?

  @@index([rfqId])
  @@index([productId])
}

// Admin's priced answer to an RFQ. A revision is a NEW row with version+1 so
// the negotiation history is preserved rather than overwritten.
model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique // QT-1001, app-generated
  rfqId           String
  rfq             Rfq             @relation(fields: [rfqId], references: [id])
  userId          String // buyer this was sent to (denormalised for scoping)
  user            User            @relation(fields: [userId], references: [id])
  createdById     String? // admin author
  createdBy       User?           @relation("QuotationAuthor", fields: [createdById], references: [id])
  version         Int             @default(1)
  status          QuotationStatus @default(DRAFT)
  // money — integer minor units (paise), same convention as Order
  subtotalMinor   Int             @default(0)
  discountMinor   Int             @default(0)
  taxMinor        Int             @default(0)
  shippingMinor   Int             @default(0)
  grandTotalMinor Int             @default(0)
  currency        String          @default("INR")
  leadTimeDays    Int?
  paymentTerms    String?
  terms           String?
  notes           String?
  buyerMessage    String? // reason on reject / requested changes
  validUntil      DateTime?
  sentAt          DateTime?
  respondedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           QuotationItem[]
  orders          Order[]
  versions        QuoteVersion[]
  paymentRequests PaymentRequest[]
  // Null = quoted by admin (house). Set = quoted by a competing seller.
  supplierId      String?
  supplier        SupplierProfile? @relation("QuotationSupplier", fields: [supplierId], references: [id])

  @@index([rfqId])
  @@index([userId])
  @@index([status])
}

model QuotationItem {
  id             String    @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItemId      String? // which requested line this answers
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id])
  productName    String
  sku            String?
  variant        String?
  specs          Json      @default("{}")
  quantity       Int
  unit           String    @default("pcs")
  unitPriceMinor Int
  discountMinor  Int       @default(0)
  taxMinor       Int       @default(0)
  lineTotalMinor Int
  notes          String?

  @@index([quotationId])
}

// ============================================================
// Marketplace: tiered pricing + commission
// ============================================================

// B2B price ladder. Resolution walks tiers ascending and the HIGHEST minQty
// not exceeding the order quantity wins:
//   base 1800 - tiers: 500 -> 1650, 2000 -> 1475
//   qty 400 -> 1800   qty 1200 -> 1650   qty 5000 -> 1475
// Prices are integer minor units (paise), like every other money column.
model PriceTier {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty         Int
  unitPriceMinor Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // One price per threshold per product — a duplicate minQty would make
  // resolution ambiguous.
  @@unique([productId, minQty])
  @@index([productId, minQty])
}

// ============================================================
// Marketplace: seller competition on RFQs
// ============================================================

enum RfqMatchStatus {
  INVITED
  VIEWED
  QUOTED
  DECLINED
}

// An RFQ invitation to one supplier. The score and reasons are SNAPSHOT here
// so the shortlist stays explainable later, even after the supplier's
// capabilities change — the buyer can see why this seller was invited.
model RfqMatch {
  id          String          @id @default(cuid())
  rfqId       String
  rfq         Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status      RfqMatchStatus  @default(INVITED)
  score       Int             @default(0)
  reasons     String[]        @default([])
  viewedAt    DateTime?
  respondedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // One invitation per supplier per RFQ.
  @@unique([rfqId, supplierId])
  @@index([supplierId, status])
}

// Append-only negotiation history. Re-quoting UPDATES the live Quotation row
// but APPENDS here, so a buyer can see that a price moved and by how much.
model QuoteVersion {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  version         Int
  subtotalMinor   Int
  discountMinor   Int       @default(0)
  taxMinor        Int       @default(0)
  shippingMinor   Int       @default(0)
  grandTotalMinor Int
  leadTimeDays    Int?
  paymentTerms    String?
  notes           String?
  // Full line snapshot at this version, so history survives line edits.
  items           Json      @default("[]")
  createdById     String?
  createdAt       DateTime  @default(now())

  @@unique([quotationId, version])
  @@index([quotationId])
}

// Buyer <-> seller thread on one RFQ. Keyed by rfq + supplier so each
// negotiation is private to that pair — a seller must never read a rival's
// conversation.
model Message {
  id          String    @id @default(cuid())
  rfqId       String
  rfq         Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId  String? // which negotiation thread; null = buyer <-> admin
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id])
  body        String
  // Timeline kind: TEXT (default), FILE (attachment via fileId → RfqFile),
  // QUOTE (a revised quotation card via quotationId → Quotation), SYSTEM.
  type        String    @default("TEXT")
  fileId      String? // → RfqFile.id when type = FILE (scalar ref, resolved in service)
  quotationId String? // → Quotation.id when type = QUOTE
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([rfqId, supplierId, createdAt])
}

// ============================================================
// Phase 3: settlement, saved requirements, CMS
// ============================================================

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  ON_HOLD
}

// A settlement cycle for one supplier.
//
// Without a row per cycle a payout has no id, date or bank reference, and a
// dispute is unanswerable — so the whole chain is STORED, not recomputed:
//   gross - commission - GST on commission - refunds = net payable
model Payout {
  id                   String          @id @default(cuid())
  payoutNumber         String          @unique // PO-xxxx
  supplierId           String
  supplier             SupplierProfile @relation(fields: [supplierId], references: [id])
  periodStart          DateTime
  periodEnd            DateTime
  grossMinor           Int             @default(0)
  commissionMinor      Int             @default(0)
  // GST charged on the platform's commission (18% in India), not on the goods.
  taxOnCommissionMinor Int             @default(0)
  refundsMinor         Int             @default(0)
  netPayableMinor      Int             @default(0)
  currency             String          @default("INR")
  status               PayoutStatus    @default(PENDING)
  // Bank reference from the transfer — what makes a settlement auditable.
  utr                  String?
  paidAt               DateTime?
  notes                String?
  orderIds             String[]        @default([]) // orders settled in this cycle
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // One settlement per supplier per period.
  @@unique([supplierId, periodStart, periodEnd])
  @@index([supplierId, status])
}

// A buyer's reusable requirement profile, so a repeat order does not mean
// re-entering every spec.
model SavedRequirement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  notes     String?
  // The RFQ line shape, stored as-is so it can seed a new RFQ directly.
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Homepage merchandising as data, so a change needs no deploy.
model CmsBlock {
  id          String   @id @default(cuid())
  key         String   @unique // hero, featured-categories, banner-strip…
  title       String?
  body        String?
  payload     Json     @default("{}")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ============================================================
// Returns, recycling & reward points
// ============================================================

// Customer-initiated ONLY. Admin reviews, selects a resolution and processes —
// it never creates a request on a customer's behalf (the old flow drove
// RETURN_REQUESTED from the admin order-status dropdown, which inverted the
// business process).
enum ReturnType {
  RETURN
  RECYCLE
}

enum ReturnResolution {
  REFUND
  REPLACEMENT
  RECYCLE
}

enum ReturnStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  // physical flow (recycle / returned goods)
  PICKUP_SCHEDULED
  RECEIVED
  INSPECTED
  // refund branch
  REFUND_PROCESSING
  REFUNDED
  // replacement branch
  REPLACEMENT_PROCESSING
  REPLACEMENT_SHIPPED
  REPLACEMENT_DELIVERED
  // recycle branch
  RECYCLE_PROCESSING
  RECYCLED
  POINTS_CREDITED
  CLOSED
  CANCELLED
}

// One request per ORDER ITEM (marketplace orders can span sellers), supporting
// partial quantities. Pickup address is a SNAPSHOT — editing the address book
// later must not change an in-flight request.
model ReturnRequest {
  id            String            @id @default(cuid())
  requestNumber String            @unique // RET-2026-000125 / REC-2026-000045
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id])
  orderItemId   String
  orderItem     OrderItem         @relation(fields: [orderItemId], references: [id])
  sellerId      String? // product's seller at request time (marketplace attribution)
  type          ReturnType
  status        ReturnStatus      @default(SUBMITTED)
  resolution    ReturnResolution?
  quantity      Int
  reason        String
  condition     String
  description   String?

  // Pickup address snapshot
  pickupName       String?
  pickupPhone      String?
  pickupLine1      String?
  pickupLine2      String?
  pickupCity       String?
  pickupState      String?
  pickupPostalCode String?
  pickupCountry    String? @default("India")

  // Admin decision
  adminNotes      String?
  rejectionReason String?
  reviewedById    String?

  // Replacement branch
  replacementQuantity    Int?
  replacementCourier     String?
  replacementTracking    String?
  replacementShippedAt   DateTime?
  replacementDeliveredAt DateTime?

  // Recycle branch: pickup + inspection (one inspection per request)
  pickupScheduledFor DateTime?
  receivedQuantity   Int?
  acceptedQuantity   Int?
  rejectedQuantity   Int?
  inspectionNotes    String?
  inspectedById      String?
  inspectedAt        DateTime?

  // Reward snapshot — rate captured at credit time so later rule edits don't
  // restate history. pointsRateX100 = points × 100 per unit.
  pointsRateX100 Int?
  pointsAwarded  Int?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  files   ReturnFile[]
  history ReturnStatusHistory[]
  refund  Refund?

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([orderItemId])
  @@index([status])
  @@index([type, status])
}

// Customer evidence (photos / documents). Private storage tree, streamed only
// through authorized routes — same policy as RFQ requirement sheets.
model ReturnFile {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  fileName        String
  storageKey      String
  mimeType        String
  size            Int
  uploadedById    String
  createdAt       DateTime      @default(now())

  @@index([returnRequestId])
}

// Append-only status trail — powers the customer timeline and the admin audit.
model ReturnStatusHistory {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  fromStatus      ReturnStatus?
  toStatus        ReturnStatus
  changedById     String? // null = system
  note            String?
  createdAt       DateTime      @default(now())

  @@index([returnRequestId, createdAt])
}

// Eco Credit ledger — immutable and append-only (was "PointsLedger"; the table
// was renamed in place, history preserved). The balance is NEVER a mutable
// counter on the user row: it is the newest row's balanceAfter and must always
// equal SUM(amount). Every credit, debit, redemption, reversal and expiration
// is a row; nothing edits or deletes one.
enum EcoCreditType {
  RECYCLING_REWARD
  REDEMPTION
  MANUAL_CREDIT
  MANUAL_DEBIT
  REVERSAL
  EXPIRATION
}

model EcoCreditTransaction {
  id           String        @id @default(cuid())
  // Strict write order. createdAt can tie within a millisecond; seq cannot.
  seq          Int           @unique @default(autoincrement())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  type         EcoCreditType
  amount       Int // signed: + credit, - debit
  balanceAfter Int
  source       String? // what produced it: RecyclingRequest | ReturnRequest | Coupon | manual | system
  referenceId  String? // id of that source row
  description  String? // customer-visible line, e.g. "Recycled cardboard — 8.5 kg"
  reason       String? // manual adjustments: the mandatory reason
  adminNote    String? // manual adjustments: internal note
  createdById  String? // admin who caused it; null = customer/system
  createdAt    DateTime      @default(now())

  // One transaction per (type, source row) — makes rewarding idempotent at the DB.
  @@unique([type, source, referenceId])
  @@index([userId, seq])
  @@index([type, createdAt])
}

// LEGACY (unused): per-product-category rate of the old order-item "recycle"
// branch. Superseded by RecyclingRule below; kept only so the table is not
// dropped. Nothing reads it any more.
model RecycleRule {
  id                String   @id @default(cuid())
  category          String   @unique
  pointsPerUnitX100 Int
  minQuantity       Int      @default(1)
  maxPoints         Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ------------------------------------------------------------
// Recycling (separate from product returns)
//
//   material -> verified quantity -> ACTIVE RecyclingRule -> credits per unit
//   -> Eco Credits (ledger) -> redemption -> customer-specific coupon -> checkout
//
// Quantities are stored x1000 (8.5 kg = 8500) and rates x100 (10 credits/kg =
// 1000) so the maths is exact integers:
//   credits = floor(verifiedQtyMilli * creditsPerUnitX100 / 100000)
// ------------------------------------------------------------
enum RecyclingUnit {
  kg
  g
  piece
  litre
}

// Admin-controlled. A material is only recyclable while it has an ACTIVE rule.
// Rules are never hard-deleted once used: they are deactivated / archived.
model RecyclingRule {
  id                 String        @id @default(cuid())
  material           String // e.g. "Cardboard" — typed by the admin, not a fixed list
  unit               RecyclingUnit
  creditsPerUnitX100 Int // credits x 100 per unit
  minQuantityMilli   Int? // smallest verified quantity that earns credits
  maxQuantityMilli   Int? // largest verified quantity accepted per request
  isActive           Boolean       @default(true)
  archivedAt         DateTime?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  requests RecyclingRequest[]

  @@index([isActive])
  @@index([material, unit])
}

enum RecyclingStatus {
  PENDING
  PICKUP_SCHEDULED
  RECEIVED
  UNDER_VERIFICATION
  APPROVED
  REJECTED
  CANCELLED
}

// Customer-submitted. The customer only ever supplies an ESTIMATE; the verified
// quantity, the rule and the credits are decided by an admin + the server.
model RecyclingRequest {
  id                     String          @id @default(cuid())
  requestNumber          String          @unique // RCY-2026-000001
  userId                 String
  user                   User            @relation(fields: [userId], references: [id])
  status                 RecyclingStatus @default(PENDING)
  material               String
  unit                   RecyclingUnit
  estimatedQuantityMilli Int
  description            String?

  // Pickup address SNAPSHOT (editing the address book later changes nothing).
  pickupName         String?
  pickupPhone        String?
  pickupLine1        String?
  pickupLine2        String?
  pickupCity         String?
  pickupState        String?
  pickupPostalCode   String?
  pickupCountry      String?   @default("India")
  pickupScheduledFor DateTime?
  receivedAt         DateTime?

  // Verification (admin). ruleId is the rule SELECTED; the rule* columns are
  // the SNAPSHOT frozen at approval, so later rule edits never restate history.
  verifiedQuantityMilli  Int?
  condition              String?
  adminNotes             String?
  ruleId                 String?
  rule                   RecyclingRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  calculatedCredits      Int? // server calculation shown to the admin before approval
  verifiedById           String?
  verifiedAt             DateTime?
  ruleMaterial           String?
  ruleUnit               RecyclingUnit?
  ruleCreditsPerUnitX100 Int?
  creditsAwarded         Int?
  approvedById           String?
  approvedAt             DateTime?
  rejectionReason        String?
  rejectedById           String?
  closedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files   RecyclingFile[]
  history RecyclingStatusHistory[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([material])
}

// Customer photos. Private storage, streamed only through authorized routes.
model RecyclingFile {
  id                 String           @id @default(cuid())
  recyclingRequestId String
  recyclingRequest   RecyclingRequest @relation(fields: [recyclingRequestId], references: [id], onDelete: Cascade)
  fileName           String
  storageKey         String
  mimeType           String
  size               Int
  uploadedById       String
  createdAt          DateTime         @default(now())

  @@index([recyclingRequestId])
}

model RecyclingStatusHistory {
  id                 String           @id @default(cuid())
  recyclingRequestId String
  recyclingRequest   RecyclingRequest @relation(fields: [recyclingRequestId], references: [id], onDelete: Cascade)
  fromStatus         RecyclingStatus?
  toStatus           RecyclingStatus
  changedById        String? // null = system
  note               String?
  createdAt          DateTime         @default(now())

  @@index([recyclingRequestId, createdAt])
}

// Eco Reward settings — singleton row (id = "default"). How Eco Credits turn
// into a coupon in the EXISTING coupon system. Nothing here is hard-coded: the
// row is created disabled with no conversion until the admin configures it.
model EcoRewardSetting {
  id                    String      @id @default("default")
  enabled               Boolean     @default(false)
  minCreditsToRedeem    Int? // wallet balance needed before redeeming at all
  creditsRequired       Int? // credits per reward unit
  couponValueMinor      Int? // coupon value per reward unit (paise)
  couponValidityDays    Int? // generated coupon lifetime
  couponMinOrderMinor   Int? // minimum order for the generated coupon
  couponUsageLimit      Int         @default(1)
  // One coupon is used per order, so this caps how many reward units a customer
  // may combine into ONE coupon.
  maxUnitsPerRedemption Int         @default(1)
  allowCombine          Boolean     @default(false)
  appliesTo             CouponScope @default(all)
  productIds            String[]    @default([])
  categoryIds           String[]    @default([])
  creditExpiryEnabled   Boolean     @default(false)
  creditExpiryDays      Int?
  updatedById           String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

// ============================================================
// Bulk catalog import history & audit (Phases 14/16/19)
// ============================================================

enum CatalogImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

// One row per bulk-import run. Records who imported what, the outcome counts
// and timings — the audit trail the console-only importer never persisted.
// The Excel file itself is never stored here (only its name + row outcomes).
model CatalogImport {
  id            String              @id @default(cuid())
  fileName      String?
  fileSizeBytes Int?
  mode          String              @default("update") // create | update | skip
  actorId       String?
  actor         User?               @relation("CatalogImporter", fields: [actorId], references: [id], onDelete: SetNull)
  sellerId      String? // set for seller-scoped imports (future)
  status        CatalogImportStatus @default(PROCESSING)
  totalRows     Int                 @default(0)
  created       Int                 @default(0)
  updated       Int                 @default(0)
  skipped       Int                 @default(0)
  failed        Int                 @default(0)
  imagesMatched Int                 @default(0)
  errorCount    Int                 @default(0)
  warningCount  Int                 @default(0)
  startedAt     DateTime            @default(now())
  completedAt   DateTime?

  errors CatalogImportError[]

  @@index([startedAt])
  @@index([status])
}

// Per-row issue captured during an import, for the downloadable error report.
model CatalogImportError {
  id        String        @id @default(cuid())
  importId  String
  import    CatalogImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber Int?
  sku       String?
  level     String // error | warning
  field     String?
  message   String
  createdAt DateTime      @default(now())

  @@index([importId])
}
