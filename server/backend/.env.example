# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rehab_hms

# Auth (used from the authentication step onwards) --------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS ----------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional origins
EXTRA_CORS_ORIGINS=

# Runtime -------------------------------------------------------------------
# Development-only role switcher and seeded demo credentials.
# MUST be false in any environment with real data.
DEMO_MODE=false

ENVIRONMENT=development
LOG_LEVEL=INFO
DB_ECHO=false

# Windows only: PostgreSQL bin directory holding libpq.dll.
# Only needed when using the pure-Python psycopg driver (e.g. on Python 3.14,
# where psycopg[binary] has no wheel). Leave blank otherwise.
# PGBIN=C:\Program Files\PostgreSQL\16\bin

# --- AI layer ----------------------------------------------------------------
# Every AI feature works without these: the deterministic half of each agent
# still runs, and the response says the model was unavailable rather than
# inventing anything. Leave blank to run the HMS with AI off.
#
# NEVER commit a real key. This file holds placeholders only.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5

# Per-agent hourly allowance per user. AI_RATE_LIMIT_PER_HOUR is the fallback
# for any agent without its own line.
AI_RATE_LIMIT_PER_HOUR=60
AI_LIMIT_PATIENT_RECAP=20
AI_LIMIT_CLINICAL_DOCUMENTATION=30
AI_LIMIT_BILLING_ACCURACY=30
AI_LIMIT_FOLLOW_UP=20
AI_LIMIT_FINANCE_INSIGHTS=20

# What the deployment pays, per million tokens. Left at zero, no cost is
# estimated at all — an invented figure is worse than an absent one.
AI_INPUT_COST_PER_MTOK=0
AI_OUTPUT_COST_PER_MTOK=0
# Prompts and completions carry clinical context. Turn this on only to debug,
# and only in development — payloads are redacted, but they are still context.
AI_STORE_PAYLOADS=false

# --- OCR ---------------------------------------------------------------------
OCR_PROVIDER=
OCR_API_KEY=
OCR_ENDPOINT=

# --- Messaging (SMS / WhatsApp) ----------------------------------------------
# Unset means a reminder is drafted and queued but never dispatched, which is
# the correct default with no provider behind it.
MESSAGING_PROVIDER=
MESSAGING_API_KEY=
MESSAGING_SENDER_ID=
MESSAGING_ENDPOINT=
