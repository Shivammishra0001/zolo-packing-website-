# ============================================================
# Zolo Packing API — environment template
#
#   cp server/.env.example server/.env    then fill in real values
#
# server/.env is git-ignored. This template is safe to commit because every
# value below is a placeholder.
#
# HOW THESE ARE LOADED
#   Local dev : `node --env-file=.env index.mjs` (see server/package.json).
#               There is NO dotenv dependency — Node reads the file natively.
#   Production: the platform injects real environment variables. server/.env
#               does NOT exist in the container, and `npm start` (node
#               server.mjs) passes no --env-file. Anything missing there must
#               be set in the DigitalOcean UI.
#
# SYNTAX RULES (a malformed file is a top cause of production 500s)
#   - exactly ONE variable per line, as KEY=value
#   - no spaces around `=`
#   - quotes optional, but must be balanced; never nest a quote inside a quote
#   - the file must end with a newline
#   - never let one line run into the next, e.g. this is INVALID and silently
#     produces a corrupt DATABASE_URL plus a missing JWT_SECRET:
#       DATABASE_URL="postgresql://..."JWT_SECRET=abc
#
# Validate at any time with:
#   node --env-file=server/.env -e 'new URL(process.env.DATABASE_URL); console.log("ok")'
# ============================================================

# development | production
# `production` also disables localhost CORS origins and the insecure dev
# fallbacks below, so never set it while developing locally.
NODE_ENV=development


# ---- Database ----------------------------------------------------------
# REQUIRED. Read by Prisma via env("DATABASE_URL") in prisma/schema.prisma.
# If this is wrong the server still STARTS and /api/v1/public/health still
# returns 200, but every database-backed route returns 500 (products,
# categories, login, register). /api/v1/public/ready returns 503 — use it to
# tell a database problem apart from an application bug.
#
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# If the password contains @ : / ? # or %, it MUST be percent-encoded.
#
# Local (Homebrew Postgres, trust auth):
DATABASE_URL="postgresql://postgres@localhost:5432/zolo_packing"
#
# DigitalOcean Managed Postgres — copy the URI from the database's
# "Connection Details" panel. TLS is mandatory there, hence sslmode=require:
# DATABASE_URL="postgresql://doadmin:PASSWORD@db-postgresql-blr1-00000-do-user-000000-0.j.db.ondigitalocean.com:25060/defaultdb?sslmode=require"
#
# Postgres running in docker-compose on the same Droplet:
# DATABASE_URL="postgresql://zolo:DB_PASSWORD@db:5432/zolo_packing"


# ---- Server ------------------------------------------------------------
# Local API port. In production the PLATFORM sets PORT (App Platform uses
# 8080); do not hardcode it there.
PORT=5001

# Number of reverse proxies in front of this server.
#   0  direct exposure (local development)
#   1  behind one nginx / load balancer  <- use this on DigitalOcean
#
# This decides what req.ip resolves to. Login rate limiting is keyed on it, so
# a wrong value either throttles every user as one client (too high) or lets
# X-Forwarded-For be spoofed to bypass the limit (too low).
TRUST_PROXY_HOPS=0


# ---- Auth secrets ------------------------------------------------------
# REQUIRED in production. The server REFUSES TO START if JWT_SECRET is missing
# or looks like a placeholder (< 32 chars, or containing "change-me",
# "secret", "dev-insecure-jwt-secret"). A crash loop on deploy means this is
# unset — that is deliberate: a weak secret makes every access token forgeable.
#
# Generate a fresh value per environment — never reuse a dev secret in prod:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating JWT_SECRET immediately signs out every user. That is safe, and is
# the correct response to a suspected leak.
JWT_SECRET="generate-me-see-command-above"

# Optional, with defaults. Any ms/vercel string ("15m", "1h", "7d").
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# REQUIRED in production. AES-256-GCM key for supplier bank account numbers.
# It is SHA-256 hashed to 32 bytes internally (see server/src/lib/crypto.mjs),
# so ANY length or encoding works — only entropy matters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING — TREAT AS WRITE-ONCE. Rotating this key makes every existing
# SupplierBankAccount.accountNumberEnc row PERMANENTLY UNREADABLE. There is no
# recovery: the plaintext account number is never stored anywhere else (only
# accountLast4). Rotate only against an empty table, or after re-encrypting
# every row with the old key still available.
BANK_ENC_KEY="generate-me-see-command-above"


# ---- CORS --------------------------------------------------------------
# Comma-separated EXACT origins (scheme + host + port). Never a wildcard.
#
# Leave EMPTY for a single-service deployment where one process serves both the
# SPA and the API (the DigitalOcean setup): those requests are same-origin and
# are admitted automatically, so CORS never applies.
#
# You MUST list origins here when they genuinely differ, including:
#   - a separate frontend domain
#   - www vs non-www: https://example.com and https://www.example.com are
#     DIFFERENT origins. Serving both without listing both returns 403 on the
#     SPA's own /assets/*.js and /assets/*.css, which renders a blank page.
#
# In development, localhost origins are allowed automatically.
CORS_ORIGINS=""
# CORS_ORIGINS="https://zolopackaging.com,https://www.zolopackaging.com"


# ---- Uploads -----------------------------------------------------------
# Public base URL for PRODUCT IMAGES, served by this Node process from
# /uploads. It is only used to BUILD absolute URLs returned in API responses —
# pointing it at localhost in production yields image URLs the browser cannot
# load, so set it to the real public origin.
#
# Supplier KYC documents (GST/PAN/bank proof) are NOT served from here — they
# live in a directory with no static mount and are streamed only by an
# authorized route. Do not point this at that directory.
UPLOADS_BASE_URL="http://localhost:5001/uploads"
# UPLOADS_BASE_URL="https://zolopackaging.com/uploads"


# ---- Super-admin seed --------------------------------------------------
# Used only by `npm run seed:admin`. After the first deploy, sign in, change
# the password in the app, then delete ADMIN_PASSWORD from this file.
# Do NOT set these as permanent production environment variables.
ADMIN_EMAIL="admin@zolopackaging.com"
ADMIN_PASSWORD="set-a-strong-password"
ADMIN_ROLE="admin"


# ---- docker-compose only -----------------------------------------------
# Password for the bundled Postgres container. Ignored when DATABASE_URL points
# at a managed database (which is the recommended setup).
# DB_PASSWORD="generate-me"


# ---- Payment gateway (not yet integrated) ------------------------------
# Only COD and offline methods (NEFT/cheque/bank transfer) work today. Card and
# UPI are deliberately rejected at checkout until a gateway is wired up.
# PAYMENT_PROVIDER="razorpay"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
